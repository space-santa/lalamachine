<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- For Windows, with its WinRT APIs for the media controls: for a Windows runtime, like publish -r win-x64 on any
         system, and for none when built on Windows. -p:ForWindows=true elsewhere sees that it compiles. -->
    <ForWindows Condition="'$(ForWindows)' == '' And '$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier.StartsWith('win'))</ForWindows>
    <ForWindows Condition="'$(ForWindows)' == '' And '$(OS)' == 'Windows_NT'">true</ForWindows>
    <TargetFramework Condition="'$(ForWindows)' == 'true'">net10.0-windows10.0.19041.0</TargetFramework>
    <EnableWindowsTargeting Condition="'$(ForWindows)' == 'true'">true</EnableWindowsTargeting>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\lalamachine.ico</ApplicationIcon>
    <Version>5.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <!-- For Linux, where it finds the system's VLC. macOS and Windows play through lalamachine's own engine. -->
    <PackageReference Include="LibVLCSharp" Version="3.10.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LalaDb\LalaDb.csproj" />
    <ProjectReference Include="..\Lalamachine.ViewModel\Lalamachine.ViewModel.csproj" />
    <ProjectReference Include="..\LibLala\LibLala.csproj" />
    <ProjectReference Include="..\Settings\Settings.csproj" />
  </ItemGroup>

</Project>
