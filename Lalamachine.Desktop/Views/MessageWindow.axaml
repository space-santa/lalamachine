<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Lalamachine.Desktop.Views.MessageWindow"
        Title="lalamachine"
        Icon="/Assets/lalamachine.ico"
        SizeToContent="WidthAndHeight"
        MaxWidth="800"
        CanResize="False"
        WindowStartupLocation="CenterOwner">
    <!-- The buttons come first, so that they always fit. The text gets what's left and scrolls. -->
    <DockPanel x:Name="MessagePanel" Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,16,0,0">
            <Button Content="OK" IsDefault="True" Click="OkButton_Click" />
            <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" IsVisible="False" Click="CancelButton_Click" />
        </StackPanel>
        <ScrollViewer MaxHeight="600" HorizontalScrollBarVisibility="Disabled">
            <SelectableTextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="18" Foreground="White" />
        </ScrollViewer>
    </DockPanel>
</Window>
