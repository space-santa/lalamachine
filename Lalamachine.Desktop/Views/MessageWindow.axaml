<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Lalamachine.Desktop.Views.MessageWindow"
        Title="lalamachine"
        Icon="/Assets/lalamachine.ico"
        SizeToContent="WidthAndHeight"
        MaxWidth="800"
        CanResize="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="16" Spacing="16">
        <!-- Some messages are long reports, the window has to fit on the screen. -->
        <ScrollViewer MaxHeight="600" HorizontalScrollBarVisibility="Disabled">
            <SelectableTextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="18" Foreground="White" />
        </ScrollViewer>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="OK" IsDefault="True" Click="OkButton_Click" />
            <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" IsVisible="False" Click="CancelButton_Click" />
        </StackPanel>
    </StackPanel>
</Window>
