<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Lalamachine.Desktop.Views.TextInputWindow"
        Title="lalamachine"
        Icon="/Assets/lalamachine.ico"
        SizeToContent="Height"
        Width="480"
        CanResize="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="16" Spacing="16">
        <TextBlock x:Name="PromptText" TextWrapping="Wrap" FontSize="18" Foreground="White" />
        <TextBox x:Name="InputBox" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="OK" IsDefault="True" Click="OkButton_Click" />
            <Button Content="Cancel" IsCancel="True" Click="CancelButton_Click" />
        </StackPanel>
    </StackPanel>
</Window>
