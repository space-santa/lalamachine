<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Lalamachine.Desktop"
             xmlns:vm="using:Lalamachine.ViewModel"
             xmlns:views="using:Lalamachine.Desktop.Views"
             x:Class="Lalamachine.Desktop.Views.PlayerControl"
             x:DataType="vm:PlayerViewModel">
    <!-- The cover at the left, the volume knob at the right. Between them the position slider and its buttons, and below
         them the buttons that go through the tracks, with the title and the time next to them. -->
    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,8">
        <Border Grid.Column="0" Classes="cover">
            <Panel>
                <TextBlock Text="♫" IsVisible="{Binding #Cover.Source, Converter={x:Static ObjectConverters.IsNull}}" />
                <Image x:Name="Cover" Source="{Binding Track.Cover, Converter={x:Static local:Converters.CoverToBitmap}}" />
            </Panel>
        </Border>

        <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <Grid ColumnDefinitions="Auto,Auto,*">
                <ToggleButton Grid.Column="0"
                              Content="🎛"
                              IsChecked="{Binding Transitions}"
                              ToolTip.Tip="Mix each track into the next, like a DJ" />
                <!-- Its DataContext is the ShuffleRepeatViewModel, the MainWindow sets it. -->
                <Button x:Name="ShuffleRepeatButton"
                        Grid.Column="1"
                        x:DataType="vm:ShuffleRepeatViewModel"
                        Command="{Binding ChangeShuffleRepeatCommand}"
                        Content="{Binding State, Converter={x:Static local:Converters.ShuffleRepeatContent}}" />
                <views:WaveformSlider x:Name="PositionSlider"
                                      Grid.Column="2"
                                      Minimum="0" Maximum="{Binding Duration, Converter={x:Static local:Converters.AtLeastOne}}" Value="{Binding Position}"
                                      Waveform="{Binding Waveform}"
                                      VerticalAlignment="Center" Margin="8,0" />
            </Grid>

            <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto,Auto,Auto" Margin="0,8,0,0">
                <Button Grid.Column="0" Content="⏮" Command="{Binding LastCommand}" />
                <Button Grid.Column="1"
                        Content="{Binding IsPlaying, Converter={x:Static local:Converters.IsPlayingDisplay}}"
                        Command="{Binding ChangePlayPauseCommand}" />
                <Button Grid.Column="2" Content="⏭" Command="{Binding NextCommand}" />
                <!-- Not a Label, that would take the first underscore in a title for an access key. -->
                <TextBlock Grid.Column="3"
                           Classes="label"
                           Margin="8,0,0,0"
                           TextTrimming="CharacterEllipsis"
                           Text="{Binding Track, Converter={x:Static local:Converters.TrackToTitle}}"
                           ToolTip.Tip="{Binding $self.Text}" />
                <Label Grid.Column="4" Content="{Binding Position, Converter={x:Static local:Converters.SecondsToTime}}" />
                <Label Grid.Column="5" Content="/" />
                <Label Grid.Column="6" Content="{Binding Duration, Converter={x:Static local:Converters.SecondsToTime}}" />
                <!-- After a transition, until the track is back at its own tempo. -->
                <Label Grid.Column="7" Content="{Binding BeatsPerMinute, Converter={x:Static local:Converters.BeatsPerMinuteDisplay}}" IsVisible="{Binding IsOffTempo}" />
                <!-- While the next track comes in, it too. -->
                <StackPanel Grid.Column="8" Orientation="Horizontal" IsVisible="{Binding IsMixing}">
                    <Label Content="→" />
                    <Label Content="{Binding IncomingPosition, Converter={x:Static local:Converters.SecondsToTime}}" />
                    <Label Content="/" />
                    <Label Content="{Binding IncomingDuration, Converter={x:Static local:Converters.SecondsToTime}}" />
                </StackPanel>
            </Grid>
        </StackPanel>

        <Panel Grid.Column="2" Margin="8,0">
            <views:VolumeKnob x:Name="VolumeKnob"
                              Value="{Binding Volume}"
                              IsMuted="{Binding IsMuted}"
                              ToolTip.Tip="Volume: drag up or down, hold Ctrl for small steps. Click the middle to mute."
                              ToolTip.ServiceEnabled="{Binding !#VolumeKnob.IsAdjusting}" />
            <!-- The volume above the knob while it's turned. -->
            <Popup PlacementTarget="{Binding #VolumeKnob}"
                   Placement="Top"
                   VerticalOffset="-4"
                   IsLightDismissEnabled="False"
                   IsOpen="{Binding #VolumeKnob.IsAdjusting}">
                <Border Classes="volumeTip">
                    <TextBlock Text="{Binding #VolumeKnob.Value, Converter={x:Static local:Converters.Percent}}" />
                </Border>
            </Popup>
        </Panel>
    </Grid>
</UserControl>
