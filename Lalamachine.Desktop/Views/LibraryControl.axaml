<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:Lalamachine.Desktop.Views"
             xmlns:vm="using:Lalamachine.ViewModel"
             x:Class="Lalamachine.Desktop.Views.LibraryControl"
             x:DataType="vm:LibraryViewModel"
             Loaded="UserControl_Loaded">
    <Grid RowDefinitions="*,Auto,*,Auto,Auto">
        <Grid Grid.Row="0" ColumnDefinitions="*,*,*">
            <DockPanel Grid.Column="0">
                <Panel DockPanel.Dock="Top">
                    <Label Classes="header" Content="{Binding GenreHeader}" />
                    <!-- The saved genre combinations. -->
                    <Button x:Name="GenreCombinationsButton"
                            Classes="columnFilter"
                            HorizontalAlignment="Right"
                            Margin="0,0,4,0"
                            DataContext="{Binding GenreCombinations}"
                            x:DataType="vm:GenreCombinationsViewModel"
                            ToolTip.Tip="Saved genre combinations">
                        <PathIcon Width="12" Height="14" Data="M0,0 H10 V14 L5,10 L0,14 Z" />
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight">
                                <StackPanel MinWidth="260" MaxWidth="400">
                                    <TextBlock Classes="flyoutLabel"
                                               TextWrapping="Wrap"
                                               IsVisible="{Binding !HasCombinations}"
                                               Text="None saved yet. Select some genres, then save them here to select them again in one go." />
                                    <ScrollViewer MaxHeight="400">
                                        <ItemsControl ItemsSource="{Binding Combinations}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:GenreCombination">
                                                    <DockPanel>
                                                        <Button DockPanel.Dock="Right"
                                                                Classes="flyoutItem"
                                                                Content="✕"
                                                                ToolTip.Tip="Delete"
                                                                Command="{Binding $parent[ItemsControl].((vm:GenreCombinationsViewModel)DataContext).DeleteCommand}"
                                                                CommandParameter="{Binding}" />
                                                        <Button Classes="flyoutItem"
                                                                HorizontalAlignment="Stretch"
                                                                Click="GenreCombination_Click"
                                                                ToolTip.Tip="{Binding GenresString}">
                                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                        </Button>
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                    <Button Classes="flyoutAction"
                                            Content="Save the selected genres..."
                                            Command="{Binding SaveCommand}"
                                            IsEnabled="{Binding CanSave}" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </Panel>
                <ListBox x:Name="GenreList" ItemsSource="{Binding GenreList}" SelectionMode="Multiple" SelectionChanged="GenreList_SelectionChanged" />
            </DockPanel>
            <DockPanel Grid.Column="1">
                <Label DockPanel.Dock="Top" Classes="header" Content="{Binding ArtistHeader}" />
                <ListBox x:Name="ArtistList" ItemsSource="{Binding ArtistList}" SelectionMode="Multiple" SelectionChanged="ArtistList_SelectionChanged" />
            </DockPanel>
            <DockPanel Grid.Column="2">
                <Label DockPanel.Dock="Top" Classes="header" Content="{Binding AlbumHeader}" />
                <ListBox x:Name="AlbumList" ItemsSource="{Binding AlbumList}" SelectionMode="Multiple" SelectionChanged="AlbumList_SelectionChanged">
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Add to queue" Command="{Binding AddAlbumsToQueueCommand}" CommandParameter="{Binding #AlbumList.SelectedItems}" />
                            <MenuItem Header="Replace queue" Command="{Binding ReplaceQueueWithAlbumsCommand}" CommandParameter="{Binding #AlbumList.SelectedItems}" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                </ListBox>
            </DockPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="Auto,*">
            <Button Grid.Column="0" Content="🧹" Click="ClearButton_Click" />
            <!-- One way: the code behind decides when the typed text is long enough to search for. -->
            <TextBox x:Name="SearchBox" Grid.Column="1" Text="{Binding SearchString, Mode=OneWay}" TextChanged="SearchBox_TextChanged" />
        </Grid>

        <views:LibraryPlaylistControl x:Name="LibraryPlaylist" Grid.Row="2" />

        <Label Grid.Row="3" IsVisible="{Binding Scanning}" HorizontalAlignment="Center" FontSize="24" Content="Scanning..." />
        <ProgressBar Grid.Row="4"
                     Height="12"
                     Foreground="DarkOrange"
                     IsVisible="{Binding Scanning}"
                     Minimum="0"
                     Maximum="{Binding FilesToScanCount}"
                     Value="{Binding FilesScannedCount}" />
    </Grid>
</UserControl>
