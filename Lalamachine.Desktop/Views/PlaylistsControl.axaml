<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Lalamachine.Desktop"
             xmlns:vm="using:Lalamachine.ViewModel"
             x:Class="Lalamachine.Desktop.Views.PlaylistsControl"
             x:DataType="vm:PlaylistsViewModel">
    <Grid ColumnDefinitions="240,*">
        <DockPanel Grid.Column="0">
            <Label DockPanel.Dock="Top" Classes="header" Content="Playlists" />
            <!-- First, so that it is the lowest one. -->
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="4">
                <Button Classes="text"
                        Content="Pull from Jellyfin"
                        ToolTip.Tip="Gets a playlist from Jellyfin, with the tracks the library here has. Replaces the one with the same name here."
                        Command="{Binding PullPlaylistCommand}"
                        IsEnabled="{Binding !IsPulling}" />
                <Label Content="Pulling..." IsVisible="{Binding IsPulling}" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal">
                <Button Content="➕" ToolTip.Tip="New playlist" Command="{Binding AddPlaylistCommand}" />
                <Button Content="✏" ToolTip.Tip="Rename playlist" Command="{Binding RenamePlaylistCommand}" IsEnabled="{Binding SelectedPlaylist.CanRenameAndDelete, FallbackValue=False}" />
                <Button Content="🗑" ToolTip.Tip="Delete playlist" Command="{Binding DeletePlaylistCommand}" IsEnabled="{Binding SelectedPlaylist.CanRenameAndDelete, FallbackValue=False}" />
            </StackPanel>
            <ListBox x:Name="PlaylistList" ItemsSource="{Binding Playlists}" SelectedItem="{Binding SelectedPlaylist}" SelectionMode="AlwaysSelected">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:NamedPlaylistViewModel">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="●" ToolTip.Tip="Has a new order that isn't saved" IsVisible="{Binding HasUnsavedOrder}" />
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- The grid's DataContext is the playlist, so that everything it has in common with the other grids of tracks works the same. -->
        <Panel Grid.Column="1" DataContext="{Binding SelectedPlaylist}">
            <Grid RowDefinitions="*,Auto" x:DataType="vm:NamedPlaylistViewModel">
                <DataGrid x:Name="PlaylistGrid"
                          Grid.Row="0"
                          ItemsSource="{Binding Playlist}"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          CanUserReorderColumns="True"
                          CanUserResizeColumns="True"
                          CanUserSortColumns="True"
                          GridLinesVisibility="None">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Add to queue" Command="{Binding AddSelectionToQueueCommand}" CommandParameter="{Binding #PlaylistGrid.SelectedItems}" />
                            <MenuItem Header="Remove from this playlist" Command="{Binding RemoveTrackCommand}" CommandParameter="{Binding #PlaylistGrid.SelectedItem}" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <!-- The Tag is the column's name, see TrackGrid. -->
                        <DataGridTextColumn x:DataType="vm:PlaylistTags" Header="🔊" Tag="Playing" CanUserSort="False" Binding="{Binding IsPlaying, Mode=OneWay, Converter={x:Static local:Converters.PlaylistItemIsPlaying}}" />
                        <DataGridTemplateColumn Tag="Liked" CanUserSort="False" CellTemplate="{StaticResource HeartCell}" />
                        <DataGridTextColumn x:DataType="vm:PlaylistTags" Header="Title" Tag="Title" Binding="{Binding Title}" />
                        <DataGridTextColumn x:DataType="vm:PlaylistTags" Header="Length" Tag="Length" Binding="{Binding LengthString}" />
                        <DataGridTextColumn x:DataType="vm:PlaylistTags" Header="Key" Tag="Key" Binding="{Binding InitialKey}" />
                        <DataGridTextColumn x:DataType="vm:PlaylistTags" Header="BPM" Tag="BPM" Binding="{Binding BeatsPerMinuteString}" />
                        <DataGridTextColumn x:DataType="vm:PlaylistTags" Header="Artist" Tag="Artist" Binding="{Binding ArtistString}" />
                        <DataGridTextColumn x:DataType="vm:PlaylistTags" Header="Genre" Tag="Genre" Binding="{Binding GenreString}" />
                        <DataGridTextColumn x:DataType="vm:PlaylistTags" Header="Track" Tag="Track" Binding="{Binding Track}" />
                        <DataGridTextColumn x:DataType="vm:PlaylistTags" Header="Disc" Tag="Disc" Binding="{Binding DiscNumber}" />
                        <DataGridTextColumn x:DataType="vm:PlaylistTags" Header="Comment" Tag="Comment" Binding="{Binding Comment}" />
                        <DataGridTextColumn x:DataType="vm:PlaylistTags" Header="Album" Tag="Album" Binding="{Binding Album}" />
                        <DataGridTextColumn x:DataType="vm:PlaylistTags" Header="Year" Tag="Year" Binding="{Binding Year}" />
                    </DataGrid.Columns>
                </DataGrid>
                <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Label Content="{Binding NumberOfTracks}" />
                        <Label Content="Tracks, Total Playtime:" />
                        <Label Content="{Binding TotalPlaytime, Converter={x:Static local:Converters.SecondsToTime}}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" IsVisible="{Binding HasUnsavedOrder}">
                        <Button Classes="text" Content="Save order" Command="{Binding SaveOrderCommand}" />
                        <Button Classes="text" Content="Discard" Command="{Binding DiscardOrderCommand}" Click="DiscardButton_Click" />
                    </StackPanel>
                    <!-- Not with a new order that isn't saved, what gets pushed has to be what's on screen. -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" IsVisible="{Binding !HasUnsavedOrder}">
                        <Label Content="Pushing..." IsVisible="{Binding $parent[UserControl].((vm:PlaylistsViewModel)DataContext).IsPushing}" />
                        <Button Classes="text"
                                Content="Push to Jellyfin"
                                ToolTip.Tip="Creates this playlist in Jellyfin, or replaces the one with the same name there"
                                Command="{Binding $parent[UserControl].((vm:PlaylistsViewModel)DataContext).PushPlaylistCommand}"
                                IsEnabled="{Binding !$parent[UserControl].((vm:PlaylistsViewModel)DataContext).IsPushing}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Panel>
    </Grid>
</UserControl>
