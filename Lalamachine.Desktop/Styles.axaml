<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Lalamachine.ViewModel"
        xmlns:views="using:Lalamachine.Desktop.Views">

    <!-- Dark blue, white text, grey gradient buttons that turn orange. -->
    <Styles.Resources>
        <LinearGradientBrush x:Key="ControlBrush" StartPoint="50%,0%" EndPoint="50%,100%">
            <GradientStop Offset="0" Color="White" />
            <GradientStop Offset="1" Color="#FF808080" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="ControlMouseOverBrush" StartPoint="50%,0%" EndPoint="50%,100%">
            <GradientStop Offset="0" Color="White" />
            <GradientStop Offset="1" Color="Orange" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="ControlPressedBrush" StartPoint="50%,0%" EndPoint="50%,100%">
            <GradientStop Offset="0" Color="White" />
            <GradientStop Offset="1" Color="DarkOrange" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="ControlBorderBrush" StartPoint="50%,0%" EndPoint="50%,100%">
            <GradientStop Offset="0" Color="#FFCCCCCC" />
            <GradientStop Offset="1" Color="#FF444444" />
        </LinearGradientBrush>
        <!-- A toggle button that's on is pressed in: the gradients and the border upside down. -->
        <LinearGradientBrush x:Key="ControlCheckedBrush" StartPoint="50%,0%" EndPoint="50%,100%">
            <GradientStop Offset="0" Color="#FF808080" />
            <GradientStop Offset="1" Color="White" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="ControlCheckedMouseOverBrush" StartPoint="50%,0%" EndPoint="50%,100%">
            <GradientStop Offset="0" Color="Orange" />
            <GradientStop Offset="1" Color="White" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="ControlCheckedPressedBrush" StartPoint="50%,0%" EndPoint="50%,100%">
            <GradientStop Offset="0" Color="DarkOrange" />
            <GradientStop Offset="1" Color="White" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="ControlCheckedBorderBrush" StartPoint="50%,0%" EndPoint="50%,100%">
            <GradientStop Offset="0" Color="#FF444444" />
            <GradientStop Offset="1" Color="#FFCCCCCC" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="PlayerBackgroundBrush" StartPoint="50%,100%" EndPoint="50%,0%">
            <GradientStop Offset="0" Color="LightBlue" />
            <GradientStop Offset="1" Color="DarkBlue" />
        </LinearGradientBrush>

        <StaticResource x:Key="ButtonBackground" ResourceKey="ControlBrush" />
        <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="ControlMouseOverBrush" />
        <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="ControlPressedBrush" />
        <StaticResource x:Key="ButtonBorderBrush" ResourceKey="ControlBorderBrush" />
        <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="ControlBorderBrush" />
        <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="ControlBorderBrush" />
        <SolidColorBrush x:Key="ButtonForeground" Color="Black" />
        <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="Black" />
        <SolidColorBrush x:Key="ButtonForegroundPressed" Color="Black" />

        <!-- The player's toggle buttons, like the buttons when they're off. -->
        <StaticResource x:Key="ToggleButtonBackground" ResourceKey="ControlBrush" />
        <StaticResource x:Key="ToggleButtonBackgroundPointerOver" ResourceKey="ControlMouseOverBrush" />
        <StaticResource x:Key="ToggleButtonBackgroundPressed" ResourceKey="ControlPressedBrush" />
        <StaticResource x:Key="ToggleButtonBackgroundChecked" ResourceKey="ControlCheckedBrush" />
        <StaticResource x:Key="ToggleButtonBackgroundCheckedPointerOver" ResourceKey="ControlCheckedMouseOverBrush" />
        <StaticResource x:Key="ToggleButtonBackgroundCheckedPressed" ResourceKey="ControlCheckedPressedBrush" />
        <StaticResource x:Key="ToggleButtonBorderBrush" ResourceKey="ControlBorderBrush" />
        <StaticResource x:Key="ToggleButtonBorderBrushPointerOver" ResourceKey="ControlBorderBrush" />
        <StaticResource x:Key="ToggleButtonBorderBrushPressed" ResourceKey="ControlBorderBrush" />
        <StaticResource x:Key="ToggleButtonBorderBrushChecked" ResourceKey="ControlCheckedBorderBrush" />
        <StaticResource x:Key="ToggleButtonBorderBrushCheckedPointerOver" ResourceKey="ControlCheckedBorderBrush" />
        <StaticResource x:Key="ToggleButtonBorderBrushCheckedPressed" ResourceKey="ControlCheckedBorderBrush" />
        <SolidColorBrush x:Key="ToggleButtonForeground" Color="Black" />
        <SolidColorBrush x:Key="ToggleButtonForegroundPointerOver" Color="Black" />
        <SolidColorBrush x:Key="ToggleButtonForegroundPressed" Color="Black" />
        <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="Black" />
        <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="Black" />
        <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="Black" />

        <StaticResource x:Key="DataGridColumnHeaderBackgroundBrush" ResourceKey="ControlBrush" />
        <StaticResource x:Key="DataGridColumnHeaderHoveredBackgroundBrush" ResourceKey="ControlMouseOverBrush" />
        <StaticResource x:Key="DataGridColumnHeaderPressedBackgroundBrush" ResourceKey="ControlPressedBrush" />
        <SolidColorBrush x:Key="DataGridColumnHeaderForegroundBrush" Color="Black" />
        <SolidColorBrush x:Key="DataGridRowSelectedBackgroundBrush" Color="DarkOrange" />
        <SolidColorBrush x:Key="DataGridRowSelectedHoveredBackgroundBrush" Color="DarkOrange" />
        <SolidColorBrush x:Key="DataGridRowSelectedUnfocusedBackgroundBrush" Color="DarkOrange" />
        <SolidColorBrush x:Key="DataGridRowSelectedHoveredUnfocusedBackgroundBrush" Color="DarkOrange" />
        <x:Double x:Key="DataGridRowSelectedBackgroundOpacity">1</x:Double>
        <x:Double x:Key="DataGridRowSelectedHoveredBackgroundOpacity">1</x:Double>
        <x:Double x:Key="DataGridRowSelectedUnfocusedBackgroundOpacity">1</x:Double>
        <x:Double x:Key="DataGridRowSelectedHoveredUnfocusedBackgroundOpacity">1</x:Double>

        <!-- The heart column of the grids of tracks. A cell's data context is its track, the grid's is the list. -->
        <DataTemplate x:Key="HeartCell" x:DataType="vm:PlaylistTags">
            <Button Classes="heart"
                    Classes.liked="{Binding IsLiked}"
                    Focusable="False"
                    Command="{Binding $parent[DataGrid].((vm:PlaylistBaseViewModel)DataContext).ToggleLikedCommand}"
                    CommandParameter="{Binding}">
                <Path Data="M12,21 C12,21 3,15 3,8.5 C3,5.5 5.4,3 8.2,3 C9.8,3 11.2,3.9 12,5.2 C12.8,3.9 14.2,3 15.8,3 C18.6,3 21,5.5 21,8.5 C21,15 12,21 12,21 Z" />
            </Button>
        </DataTemplate>

        <!-- The position slider, as high as the buttons next to it. The slider draws the waveform, orange up to where the
             track plays. Over it, a track as large as the slider and nothing to see on it: the slider seeks to wherever
             either side of it is pressed, and follows a drag from there. -->
        <ControlTemplate x:Key="WaveformSliderPart" TargetType="RepeatButton">
            <Border Background="Transparent" />
        </ControlTemplate>
        <ControlTheme x:Key="{x:Type views:WaveformSlider}" TargetType="views:WaveformSlider">
            <Setter Property="Height" Value="48" />
            <Setter Property="PlayedBrush" Value="DarkOrange" />
            <Setter Property="UnplayedBrush" Value="#B3FFFFFF" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Track Name="PART_Track"
                           Orientation="Horizontal"
                           Minimum="{TemplateBinding Minimum}"
                           Maximum="{TemplateBinding Maximum}"
                           Value="{TemplateBinding Value, Mode=TwoWay}">
                        <Track.DecreaseButton>
                            <RepeatButton Name="PART_DecreaseButton" Focusable="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Template="{StaticResource WaveformSliderPart}" />
                        </Track.DecreaseButton>
                        <Track.IncreaseButton>
                            <RepeatButton Name="PART_IncreaseButton" Focusable="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Template="{StaticResource WaveformSliderPart}" />
                        </Track.IncreaseButton>
                        <!-- Where the colours meet is where the track plays. -->
                        <Thumb Width="0">
                            <Thumb.Template>
                                <ControlTemplate>
                                    <Panel />
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                    </Track>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover">
                <Setter Property="UnplayedBrush" Value="White" />
            </Style>
        </ControlTheme>
    </Styles.Resources>

    <Style Selector="Window">
        <Setter Property="Background" Value="DarkBlue" />
    </Style>

    <Style Selector="Border.player">
        <Setter Property="Background" Value="{StaticResource PlayerBackgroundBrush}" />
    </Style>

    <!-- The cover of the track that plays, as high as the two rows of buttons next to it. A note when there's none. -->
    <Style Selector="Border.cover">
        <Setter Property="Width" Value="104" />
        <Setter Property="Height" Value="104" />
        <Setter Property="Margin" Value="8,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="#33FFFFFF" />
    </Style>
    <Style Selector="Border.cover TextBlock">
        <Setter Property="FontSize" Value="40" />
        <Setter Property="Foreground" Value="#80FFFFFF" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="TabItem">
        <Setter Property="FontSize" Value="24" />
    </Style>

    <Style Selector="Label">
        <Setter Property="FontFamily" Value="Calibri" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Looks like a Label (with its default padding), for text that may contain underscores. -->
    <Style Selector="TextBlock.label">
        <Setter Property="FontFamily" Value="Calibri" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Padding" Value="3" />
    </Style>

    <!-- The headers above the genre, artist and album lists, like the playlist's column headers. -->
    <Style Selector="Label.header">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="Foreground" Value="Black" />
        <Setter Property="Background" Value="{StaticResource ControlBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ControlBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,1" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="4,2" />
    </Style>

    <Style Selector="Button, ToggleButton">
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="MinWidth" Value="64" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- Pressed in, what's on it a little lower. -->
    <Style Selector="ToggleButton:checked">
        <Setter Property="Padding" Value="2,4,2,0" />
    </Style>

    <Style Selector="TextBox">
        <Setter Property="FontFamily" Value="Calibri" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="White" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox:pointerover, TextBox:focus">
        <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement, TextBox:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="White" />
    </Style>

    <Style Selector="ComboBox, ComboBoxItem">
        <Setter Property="FontFamily" Value="Calibri" />
        <Setter Property="FontSize" Value="20" />
    </Style>

    <Style Selector="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="ListBoxItem">
        <Setter Property="FontFamily" Value="Calibri" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Padding" Value="4,2" />
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter, ListBoxItem:selected:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="DarkOrange" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <Style Selector="DataGrid">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontFamily" Value="Calibri" />
        <Setter Property="FontSize" Value="20" />
    </Style>
    <Style Selector="DataGridColumnHeader">
        <Setter Property="FontFamily" Value="Calibri" />
        <Setter Property="FontSize" Value="20" />
    </Style>

    <!-- The row of the track that plays, in its own colour. The selection's orange goes over it. -->
    <Style Selector="DataGridRow" x:DataType="vm:PlaylistTags">
        <Setter Property="views:TrackRow.IsPlaying" Value="{Binding IsPlaying}" />
    </Style>
    <Style Selector="DataGridRow.playing">
        <Setter Property="Background" Value="#2D6BD6" />
    </Style>

    <!-- A cell of the Key column names the key when hovered, TrackGrid gives the column this class. A key without a natural notation has no tooltip. -->
    <Style Selector="DataGridCell.key" x:DataType="vm:PlaylistTags">
        <Setter Property="ToolTip.Tip" Value="{Binding InitialKeyNaturalNotation}" />
    </Style>

    <!-- The small button in a column header that opens the column's filter, orange while the filter is on. -->
    <Style Selector="Button.columnFilter">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.columnFilter.active">
        <Setter Property="Background" Value="DarkOrange" />
    </Style>
    <!-- What a column filter's flyout says about its fields. -->
    <Style Selector="TextBlock.flyoutLabel">
        <Setter Property="FontFamily" Value="Calibri" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="NumericUpDown.bpm">
        <Setter Property="Width" Value="140" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="999" />
        <Setter Property="Increment" Value="1" />
        <Setter Property="FormatString" Value="0" />
    </Style>
    <!-- A row of a list in a flyout, to click on. -->
    <Style Selector="Button.flyoutItem">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="FontFamily" Value="Calibri" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>
    <!-- A button with text at the bottom of a flyout. -->
    <Style Selector="Button.flyoutAction">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="FontFamily" Value="Calibri" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Margin" Value="0,8,0,0" />
    </Style>

    <!-- A button with a word or two instead of an icon. -->
    <Style Selector="Button.text">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="FontFamily" Value="Calibri" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="Padding" Value="8,2" />
    </Style>

    <!-- Empty or filled, white like the text so that it shows on a selected row too. -->
    <Style Selector="Button.heart">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.heart:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.heart:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.heart Path">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Stroke" Value="White" />
        <Setter Property="StrokeThickness" Value="1.5" />
        <Setter Property="Fill" Value="Transparent" />
    </Style>
    <Style Selector="Button.heart.liked Path">
        <Setter Property="Fill" Value="White" />
    </Style>
    <Style Selector="FlyoutPresenter CheckBox">
        <Setter Property="FontFamily" Value="Calibri" />
        <Setter Property="FontSize" Value="20" />
    </Style>

    <!-- As big as the cover at the other end of the player, in the colours of the buttons and the position slider. -->
    <Style Selector="views|VolumeKnob">
        <Setter Property="Width" Value="104" />
        <Setter Property="Height" Value="104" />
        <Setter Property="ArcBrush" Value="DarkOrange" />
        <!-- Dark, the bottom of the player is light. -->
        <Setter Property="TrackBrush" Value="#4D000080" />
        <Setter Property="MutedBrush" Value="#FF6A6A6A" />
        <Setter Property="BodyBrush" Value="{StaticResource ControlBrush}" />
        <Setter Property="BodyBorderBrush" Value="{StaticResource ControlBorderBrush}" />
        <Setter Property="PointerBrush" Value="Black" />
    </Style>
    <Style Selector="views|VolumeKnob:pointerover">
        <Setter Property="BodyBrush" Value="{StaticResource ControlMouseOverBrush}" />
    </Style>
    <Style Selector="views|VolumeKnob:focus-visible">
        <Setter Property="TrackBrush" Value="#99000080" />
    </Style>
    <!-- The volume above the knob while it's turned. -->
    <Style Selector="Border.volumeTip">
        <Setter Property="Background" Value="#E6000040" />
        <Setter Property="BorderBrush" Value="DarkOrange" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="8,2" />
    </Style>
    <Style Selector="Border.volumeTip TextBlock">
        <Setter Property="FontFamily" Value="Calibri" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="Foreground" Value="White" />
    </Style>
</Styles>
