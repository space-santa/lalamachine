<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Lalamachine.ViewModel">

    <!-- Dark blue, white text, grey gradient buttons that turn orange. -->
    <Styles.Resources>
        <LinearGradientBrush x:Key="ControlBrush" StartPoint="50%,0%" EndPoint="50%,100%">
            <GradientStop Offset="0" Color="White" />
            <GradientStop Offset="1" Color="#FF808080" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="ControlMouseOverBrush" StartPoint="50%,0%" EndPoint="50%,100%">
            <GradientStop Offset="0" Color="White" />
            <GradientStop Offset="1" Color="Orange" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="ControlPressedBrush" StartPoint="50%,0%" EndPoint="50%,100%">
            <GradientStop Offset="0" Color="White" />
            <GradientStop Offset="1" Color="DarkOrange" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="ControlBorderBrush" StartPoint="50%,0%" EndPoint="50%,100%">
            <GradientStop Offset="0" Color="#FFCCCCCC" />
            <GradientStop Offset="1" Color="#FF444444" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="PlayerBackgroundBrush" StartPoint="50%,100%" EndPoint="50%,0%">
            <GradientStop Offset="0" Color="LightBlue" />
            <GradientStop Offset="1" Color="DarkBlue" />
        </LinearGradientBrush>

        <StaticResource x:Key="ButtonBackground" ResourceKey="ControlBrush" />
        <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="ControlMouseOverBrush" />
        <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="ControlPressedBrush" />
        <StaticResource x:Key="ButtonBorderBrush" ResourceKey="ControlBorderBrush" />
        <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="ControlBorderBrush" />
        <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="ControlBorderBrush" />
        <SolidColorBrush x:Key="ButtonForeground" Color="Black" />
        <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="Black" />
        <SolidColorBrush x:Key="ButtonForegroundPressed" Color="Black" />

        <StaticResource x:Key="DataGridColumnHeaderBackgroundBrush" ResourceKey="ControlBrush" />
        <StaticResource x:Key="DataGridColumnHeaderHoveredBackgroundBrush" ResourceKey="ControlMouseOverBrush" />
        <StaticResource x:Key="DataGridColumnHeaderPressedBackgroundBrush" ResourceKey="ControlPressedBrush" />
        <SolidColorBrush x:Key="DataGridColumnHeaderForegroundBrush" Color="Black" />
        <SolidColorBrush x:Key="DataGridRowSelectedBackgroundBrush" Color="DarkOrange" />
        <SolidColorBrush x:Key="DataGridRowSelectedHoveredBackgroundBrush" Color="DarkOrange" />
        <SolidColorBrush x:Key="DataGridRowSelectedUnfocusedBackgroundBrush" Color="DarkOrange" />
        <SolidColorBrush x:Key="DataGridRowSelectedHoveredUnfocusedBackgroundBrush" Color="DarkOrange" />
        <x:Double x:Key="DataGridRowSelectedBackgroundOpacity">1</x:Double>
        <x:Double x:Key="DataGridRowSelectedHoveredBackgroundOpacity">1</x:Double>
        <x:Double x:Key="DataGridRowSelectedUnfocusedBackgroundOpacity">1</x:Double>
        <x:Double x:Key="DataGridRowSelectedHoveredUnfocusedBackgroundOpacity">1</x:Double>

        <!-- The heart column of the grids of tracks. A cell's data context is its track, the grid's is the list. -->
        <DataTemplate x:Key="HeartCell" x:DataType="vm:PlaylistTags">
            <Button Classes="heart"
                    Classes.liked="{Binding IsLiked}"
                    IsVisible="{Binding !IsOutsideLibrary}"
                    Focusable="False"
                    Command="{Binding $parent[DataGrid].((vm:PlaylistBaseViewModel)DataContext).ToggleLikedCommand}"
                    CommandParameter="{Binding}">
                <Path Data="M12,21 C12,21 3,15 3,8.5 C3,5.5 5.4,3 8.2,3 C9.8,3 11.2,3.9 12,5.2 C12.8,3.9 14.2,3 15.8,3 C18.6,3 21,5.5 21,8.5 C21,15 12,21 12,21 Z" />
            </Button>
        </DataTemplate>
    </Styles.Resources>

    <Style Selector="Window">
        <Setter Property="Background" Value="DarkBlue" />
    </Style>

    <Style Selector="Border.player">
        <Setter Property="Background" Value="{StaticResource PlayerBackgroundBrush}" />
    </Style>

    <!-- The cover of the track that plays, as high as the title and the two rows of buttons next to it. A note when there's none. -->
    <Style Selector="Border.cover">
        <Setter Property="Width" Value="136" />
        <Setter Property="Height" Value="136" />
        <Setter Property="Margin" Value="8,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="#33FFFFFF" />
    </Style>
    <Style Selector="Border.cover TextBlock">
        <Setter Property="FontSize" Value="48" />
        <Setter Property="Foreground" Value="#80FFFFFF" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="TabItem">
        <Setter Property="FontSize" Value="24" />
    </Style>

    <Style Selector="Label">
        <Setter Property="FontFamily" Value="Calibri" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Looks like a Label (with its default padding), for text that may contain underscores. -->
    <Style Selector="TextBlock.label">
        <Setter Property="FontFamily" Value="Calibri" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Padding" Value="3" />
    </Style>

    <!-- The headers above the genre, artist and album lists, like the playlist's column headers. -->
    <Style Selector="Label.header">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="Foreground" Value="Black" />
        <Setter Property="Background" Value="{StaticResource ControlBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ControlBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,1" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="4,2" />
    </Style>

    <Style Selector="Button">
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="MinWidth" Value="64" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBox">
        <Setter Property="FontFamily" Value="Calibri" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="White" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox:pointerover, TextBox:focus">
        <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement, TextBox:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="White" />
    </Style>

    <Style Selector="ComboBox, ComboBoxItem">
        <Setter Property="FontFamily" Value="Calibri" />
        <Setter Property="FontSize" Value="20" />
    </Style>

    <Style Selector="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="ListBoxItem">
        <Setter Property="FontFamily" Value="Calibri" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Padding" Value="4,2" />
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter, ListBoxItem:selected:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="DarkOrange" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <Style Selector="DataGrid">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontFamily" Value="Calibri" />
        <Setter Property="FontSize" Value="20" />
    </Style>
    <Style Selector="DataGridColumnHeader">
        <Setter Property="FontFamily" Value="Calibri" />
        <Setter Property="FontSize" Value="20" />
    </Style>

    <!-- A cell of the Key column names the key when hovered, TrackGrid gives the column this class. A key without a natural notation has no tooltip. -->
    <Style Selector="DataGridCell.key" x:DataType="vm:PlaylistTags">
        <Setter Property="ToolTip.Tip" Value="{Binding InitialKeyNaturalNotation}" />
    </Style>

    <!-- The small button in a column header that opens the column's filter, orange while the filter is on. -->
    <Style Selector="Button.columnFilter">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.columnFilter.active">
        <Setter Property="Background" Value="DarkOrange" />
    </Style>
    <!-- A button with text at the bottom of a flyout. -->
    <Style Selector="Button.flyoutAction">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="FontFamily" Value="Calibri" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Margin" Value="0,8,0,0" />
    </Style>

    <!-- A button with a word or two instead of an icon. -->
    <Style Selector="Button.text">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="FontFamily" Value="Calibri" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="Padding" Value="8,2" />
    </Style>

    <!-- Empty or filled, white like the text so that it shows on a selected row too. -->
    <Style Selector="Button.heart">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.heart:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.heart:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.heart Path">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Stroke" Value="White" />
        <Setter Property="StrokeThickness" Value="1.5" />
        <Setter Property="Fill" Value="Transparent" />
    </Style>
    <Style Selector="Button.heart.liked Path">
        <Setter Property="Fill" Value="White" />
    </Style>
    <Style Selector="FlyoutPresenter CheckBox">
        <Setter Property="FontFamily" Value="Calibri" />
        <Setter Property="FontSize" Value="20" />
    </Style>
</Styles>
