{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-wpf",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/Lalamachine.Wpf/Lalamachine.Wpf.csproj"
      ],
      "problemMatcher": "$tsc"
    },
    {
      "label": "publish",
      "command": "dotnet",
      "type": "process",
      "args": ["publish", "${workspaceFolder}/Lalamachine.Wpf/Lalamachine.Wpf.csproj", "-c", "Release"],
      "problemMatcher": "$tsc"
    },
    {
      "label": "watch",
      "command": "dotnet",
      "type": "process",
      "args": [
        "watch",
        "run",
        "--project",
        "${workspaceFolder}/Lalamachine.Wpf/Lalamachine.Wpf.csproj"
      ],
      "problemMatcher": "$tsc"
    }
  ]
}
